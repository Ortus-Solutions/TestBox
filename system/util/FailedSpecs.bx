/**
 * Copyright Since 2005 TestBox Framework by Luis Majano and Ortus Solutions, Corp
 * www.ortussolutions.com
 * ---
 * Reads and writes the `.testbox-failed.json` file the BoxLang runner keeps in the report path, so
 * `./run --failed` can rerun only what failed last time. The file looks like:
 *
 * <pre>
 * { "bundles" : [ "tests.specs.LoginSpec" ], "specs" : [ "spec id", "spec id" ], "bundleErrors" : [ "tests.specs.CartSpec" ] }
 * </pre>
 *
 * `bundles` and `specs` are what `--failed` reruns. A bundle that failed outside of a spec (for example
 * in beforeAll() or afterAll()) is a broken bundle, not a failed spec: it goes to `bundleErrors` and is
 * not rerun. Every array is empty when everything passed.
 *
 * What failed comes from TestResult.getFailedTargets(), which every runner can use; this class only keeps it
 * between two CLI runs. The web reporters need no file: their Run Failed link is built from the report.
 *
 * BoxLang only: the BoxLang runner is the only caller.
 */
class {

	static {
		FILE_NAME = ".testbox-failed.json"
	}

	/**
	 * The path of the failed specs file in a report directory.
	 *
	 * @reportPath The report directory
	 *
	 * @return The absolute path of the file
	 */
	static string function getFilePath( required string reportPath ) {
		return arguments.reportPath.reReplace( "[\\/]$", "" ) & "/" & static.FILE_NAME
	}

	/**
	 * Write what failed in a run to the report directory.
	 *
	 * @reportPath  The report directory, created when missing
	 * @testResults The TestResult of the run
	 *
	 * @return The struct that was written: `bundles`, `specs` and `bundleErrors`
	 */
	static struct function write( required string reportPath, required any testResults ) {
		var failed = arguments.testResults.getFailedTargets()
		if ( !directoryExists( arguments.reportPath ) ) {
			directoryCreate( arguments.reportPath )
		}
		fileWrite( static.getFilePath( arguments.reportPath ), jsonSerialize( failed ) )
		return failed
	}

	/**
	 * Read what failed in the last run.
	 *
	 * @reportPath The report directory
	 *
	 * @return A struct with `bundles`, `specs` and `bundleErrors` arrays, all empty when the file is missing, invalid or empty
	 */
	static struct function read( required string reportPath ) {
		var empty    = { "bundles" : [], "specs" : [], "bundleErrors" : [] }
		var filePath = static.getFilePath( arguments.reportPath )
		if ( !fileExists( filePath ) ) {
			return empty
		}
		var content = fileRead( filePath )
		if ( !isJSON( content ) ) {
			return empty
		}
		var data = jsonDeserialize( content )
		if ( !isStruct( data ) ) {
			return empty
		}
		return {
			"bundles"      : isArray( data.bundles ?: "" ) ? data.bundles : [],
			"specs"        : isArray( data.specs ?: "" ) ? data.specs : [],
			"bundleErrors" : isArray( data.bundleErrors ?: "" ) ? data.bundleErrors : []
		}
	}

}
